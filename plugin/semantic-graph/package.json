{
  "name": "engram-semantic-graph",
  "version": "1.0.0",
  "description": "Deterministic semantic knowledge graph plugin for Engram via MCP",
  "main": "dist/mcp-server.js",
  "private": true,
  "type": "module",
  "files": [
    "dist/mcp-server.js",
    "README.md"
  ],
  "scripts": {
    "preinstall": "npx lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity",
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "init-config": "node dist/cli-init.js",
    "process-graph": "node dist/processor.js"
  },
  "keywords": [
    "engram",
    "memory",
    "ai",
    "mcp-server",
    "knowledge-graph"
  ],
  "author": "Christian Torrealba <christianjtr>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.21.0",
    "lockfile-lint": "^4.14.1",
    "typescript": "^5.0.0"
  }
}
