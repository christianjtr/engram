{
    "name": "engram-semantic-graph",
    "version": "1.0.0",
    "description": "Deterministic semantic knowledge graph engine and CLI for Engram",
    "main": "dist/semantic-graph.js",
    "bin": {
        "engram-semantic-graph": "dist/semantic-graph.js"
    },
    "private": true,
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "preinstall": "npx lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity",
        "clean": "rm -rf dist",
        "build": "npm run clean && node esbuild.config.mjs",
        "dev": "node esbuild.config.mjs --watch",
        "start": "node dist/semantic-graph.js",
        "generate": "node dist/semantic-graph.js",
        "visualize": "tsx src/visualizer/server.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "test": "tsx --test tests/**/*.test.ts"
    },
    "keywords": [
        "engram",
        "memory",
        "ai",
        "cli",
        "knowledge-graph",
        "semantic-graph"
    ],
    "author": "Christian Torrealba <christianjtr>",
    "license": "MIT",
    "dependencies": {
        "dayjs": "^1.11.23",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@types/node": "^20.19.43",
        "builtin-modules": "^5.3.0",
        "esbuild": "^0.28.2",
        "lockfile-lint": "^4.14.1",
        "tsx": "^4.19.0",
        "typescript": "^5.0.0"
    }
}
